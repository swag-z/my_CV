# Logistics Doc AI - Environment Variables Example
# Copy this file to .env and adjust values as needed

# Application
APP_PORT=8080
APP_ENV=local
LOG_LEVEL=info

# Database
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/logistics_doc_ai?sslmode=disable
DATABASE_MAX_CONNS=10

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# OCR Service
OCR_SERVICE_URL=http://localhost:8000
OCR_INTERNAL_TOKEN=dev-internal-token
OCR_TIMEOUT_SECONDS=120
OCR_MOCK=false
OCR_MAX_FILE_MB=20
OCR_MAX_PAGES=10

# LLM Configuration
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=3000

# Processing Limits
MAX_FILE_MB=20
CONFIDENCE_THRESHOLD=0.80
AUTO_APPROVE=false
MAX_PROCESS_ATTEMPTS=3

# Security
SECRET_KEY=change-me-in-production

# Workers
WORKERS=2
